# Copy ke .env.local (lokal) atau set di Vercel Project Settings > Environment Variables
PGHOST=aws-0-ap-southeast-1.pooler.supabase.com
PGPORT=6543            # Vercel serverless: pakai Transaction Pooler 6543. Lokal boleh 5432 (session pooler).
PGDATABASE=postgres
PGUSER=postgres.<project-ref>
PGPASSWORD=<db-password>
PGSSL=require
SJP_SCHEMA=MPS_SJP
SESSION_SECRET=<random-string-min-32-char>
